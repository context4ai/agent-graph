{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-graph.dev/schemas/provider.schema.json",
  "title": "Agent Graph Provider Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "graphs"],
  "properties": {
    "schema": { "const": "agent-graph.provider.v1" },
    "id": { "$ref": "#/$defs/id" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "maxLength": 1000 },
    "graphs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/relativePath" }
    },
    "catalogs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "codes": { "$ref": "#/$defs/relativePath" }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agentGraph": { "type": "string", "minLength": 1 },
        "node": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._/-]*[a-z0-9])?$",
      "maxLength": 160
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "^(?:/|[A-Za-z]:|.*(?:^|/)\\.\\.(?:/|$))" }
    }
  }
}
