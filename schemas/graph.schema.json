{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-graph.dev/schemas/graph.schema.json",
  "title": "Agent Graph Definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "entrypoints", "nodes", "edges"],
  "properties": {
    "schema": { "const": "agent-graph.graph.v1" },
    "id": { "$ref": "#/$defs/id" },
    "description": { "type": "string", "maxLength": 1000 },
    "entrypoints": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/id" },
      "propertyNames": { "$ref": "#/$defs/id" }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._/-]*[a-z0-9])?$",
      "maxLength": 160
    },
    "reasonCode": {
      "type": "string",
      "pattern": "^route\\.[a-z0-9](?:[a-z0-9._/-]*[a-z0-9])?$",
      "maxLength": 160
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "^(?:/|[A-Za-z]:|.*(?:^|/)\\.\\.(?:/|$))" }
    },
    "outcome": {
      "enum": ["completed", "partial", "failed", "unverified", "skipped", "pending", "blocked", "waiting-user"]
    },
    "factCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$",
          "description": "Dotted object path; numeric segments index JSON arrays."
        },
        "equals": { "type": ["string", "number", "boolean", "null"] },
        "exists": { "type": "boolean" }
      },
      "oneOf": [
        { "required": ["equals"] },
        { "required": ["exists"] }
      ]
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/relativePath" } },
        "recommended": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/relativePath" } }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["action", "gate", "subgraph", "terminal"] },
        "description": { "type": "string", "maxLength": 1000 },
        "reasonCode": { "$ref": "#/$defs/reasonCode" },
        "priority": { "type": "integer", "minimum": -1000, "maximum": 1000, "default": 0 },
        "join": { "enum": ["all", "any"], "default": "all" },
        "action": { "$ref": "#/$defs/relativePath" },
        "graph": { "$ref": "#/$defs/id" },
        "entry": { "$ref": "#/$defs/id" },
        "gate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "prompt"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "prompt": { "type": "string", "minLength": 1, "maxLength": 1000 },
            "authority": { "$ref": "#/$defs/id" },
            "delegatable": { "type": "boolean", "default": false }
          }
        },
        "terminalOutcome": { "$ref": "#/$defs/outcome" },
        "requiresFacts": { "type": "array", "items": { "$ref": "#/$defs/factCheck" } },
        "satisfiedBy": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/factCheck" } },
        "resources": { "$ref": "#/$defs/resources" }
      },
      "oneOf": [
        {
          "properties": { "kind": { "const": "action" } },
          "required": ["action", "reasonCode"],
          "not": { "anyOf": [{ "required": ["graph"] }, { "required": ["entry"] }, { "required": ["gate"] }, { "required": ["terminalOutcome"] }] }
        },
        {
          "properties": { "kind": { "const": "gate" } },
          "required": ["gate", "reasonCode"],
          "not": { "anyOf": [{ "required": ["action"] }, { "required": ["graph"] }, { "required": ["entry"] }, { "required": ["terminalOutcome"] }] }
        },
        {
          "properties": { "kind": { "const": "subgraph" } },
          "required": ["graph", "entry"],
          "not": { "anyOf": [{ "required": ["action"] }, { "required": ["gate"] }, { "required": ["reasonCode"] }, { "required": ["terminalOutcome"] }, { "required": ["satisfiedBy"] }, { "required": ["resources"] }] }
        },
        {
          "properties": { "kind": { "const": "terminal" } },
          "required": ["terminalOutcome"],
          "not": { "anyOf": [{ "required": ["action"] }, { "required": ["graph"] }, { "required": ["entry"] }, { "required": ["gate"] }, { "required": ["reasonCode"] }, { "required": ["satisfiedBy"] }, { "required": ["resources"] }] }
        }
      ]
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "$ref": "#/$defs/id" },
        "to": { "$ref": "#/$defs/id" },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "default": ["completed"],
          "items": { "$ref": "#/$defs/outcome" }
        },
        "kind": { "enum": ["flow", "consumes", "requires", "gatedBy", "repeat"], "default": "flow" }
      }
    }
  }
}
