{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-graph.dev/schemas/resource.schema.json",
  "title": "Agent Graph Resource Descriptor",
  "oneOf": [
    { "$ref": "#/$defs/file" },
    { "$ref": "#/$defs/graphAction" },
    { "$ref": "#/$defs/hostAction" }
  ],
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "id", "kind", "mediaType", "path"],
      "properties": {
        "schema": { "const": "agent-graph.resource.file.v1" },
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["procedure", "diagnostic", "template", "schema", "skill"] },
        "mediaType": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/relativePath" },
        "description": { "type": "string", "maxLength": 1000 }
      }
    },
    "graphAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "id", "kind", "mediaType", "materializer"],
      "properties": {
        "schema": { "const": "agent-graph.resource.graph-action.v1" },
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "context-view" },
        "mediaType": { "type": "string", "minLength": 1 },
        "materializer": { "$ref": "#/$defs/relativePath" },
        "description": { "type": "string", "maxLength": 1000 }
      }
    },
    "hostAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "id", "kind", "mediaType", "materializer", "input"],
      "properties": {
        "schema": { "const": "agent-graph.resource.host-action.v1" },
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["procedure", "diagnostic", "template", "schema", "context-view", "skill"] },
        "mediaType": { "type": "string", "minLength": 1 },
        "materializer": { "$ref": "#/$defs/relativePath" },
        "input": {},
        "description": { "type": "string", "maxLength": 1000 }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._/-]*[a-z0-9])?$",
      "maxLength": 160
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "^(?:/|[A-Za-z]:|.*(?:^|/)\\.\\.(?:/|$))" }
    }
  }
}
