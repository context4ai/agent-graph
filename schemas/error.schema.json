{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-graph.dev/schemas/error.schema.json",
  "title": "Agent Graph Error Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "state", "error"],
  "properties": {
    "schema": { "const": "agent-graph.error.v1" },
    "state": { "const": "error" },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "diagnostics"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string" },
        "diagnostics": {
          "type": "array",
          "items": { "$ref": "#/$defs/diagnostic" }
        }
      }
    }
  },
  "$defs": {
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["info", "warning", "error"] },
        "message": { "type": "string" },
        "path": { "type": "string" },
        "documentRef": { "type": "string", "minLength": 1 },
        "detail": {}
      }
    }
  }
}
